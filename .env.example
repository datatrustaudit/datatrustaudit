# DataTrust Audit — Backend Configuration
# Copy to .env and fill with your values

# ═══════════════════════════════════════════
# Google Gemini API Key (for AI analysis)
# Get at: https://aistudio.google.com/app/apikey
# ═══════════════════════════════════════════
GOOGLE_API_KEY=sua_chave_aqui
GEMINI_MODEL=gemini-2.0-flash-lite

# ═══════════════════════════════════════════
# Environment
# ═══════════════════════════════════════════
ENVIRONMENT=development

# Strict evidence mode — do not hallucinate findings
STRICT_EVIDENCE_MODE=true

# ═══════════════════════════════════════════
# JWT — OBRIGATÓRIO
# A aplicação não sobe sem SECRET_KEY (mínimo 32 caracteres). Antes havia um
# default público no código: quem o conhecesse assinava um token válido para
# qualquer usuário.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
# ═══════════════════════════════════════════
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ═══════════════════════════════════════════
# Banco de dados
# SQLite serve para desenvolvimento. Em produção use Postgres: o scanner roda
# em paralelo e o SQLite trava com escrita concorrente.
# Postgres: postgresql+psycopg://usuario:senha@host:5432/banco
# ═══════════════════════════════════════════
DATABASE_URL=sqlite:///./db/gtmaudit.db

# ═══════════════════════════════════════════
# CORS
# Origens autorizadas, separadas por vírgula. Vazio = usa FRONTEND_URL.
# Não use "*": com credenciais habilitadas, qualquer site poderia fazer
# requisição autenticada em nome do usuário logado.
# ═══════════════════════════════════════════
FRONTEND_URL=http://localhost:8080
CORS_ALLOW_ORIGINS=

# ═══════════════════════════════════════════
# Pagamentos — Mercado Pago
# Credenciais em: https://www.mercadopago.com.br/developers/panel/app
#   MP_ACCESS_TOKEN   → "Credenciais de produção" > Access Token
#   MP_WEBHOOK_SECRET → Webhooks > "Assinatura secreta"
# Sem MP_WEBHOOK_SECRET a rota de webhook aceita POST de qualquer origem.
# Configure o webhook para: https://SEU_DOMINIO/api/payments/webhook
# ═══════════════════════════════════════════
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# ═══════════════════════════════════════════
# PIX direto na chave (sem intermediário)
# O cliente paga na chave abaixo e confirma pelo site; o dono recebe um e-mail
# com o botão de liberar. Sem taxa de gateway — é o que paga o desconto do PIX.
#
# PIX_CHAVE vazia = a opção some da tela em vez de mostrar um pagamento sem
# para onde pagar (a rota devolve 503).
#
# NOME e CIDADE vão dentro do "copia e cola" e aparecem no app do banco de quem
# paga. Sem acento e curtos: o padrão do BACEN limita a 25 e 15 caracteres, e
# acentuação faz parte dos bancos recusarem o código.
# ═══════════════════════════════════════════
PIX_CHAVE=
PIX_NOME_RECEBEDOR=DataTrust Audit
PIX_CIDADE=Sao Paulo
PIX_MINUTOS_VALIDADE=30

# ═══════════════════════════════════════════
# E-mail transacional (Resend)
# Sem RESEND_API_KEY nada é enviado — o pedido continua aparecendo no painel,
# e o log registra que o e-mail não saiu. Falha de e-mail nunca derruba um
# pagamento.
#
# EMAIL_REMETENTE precisa ser de domínio verificado no Resend. O padrão
# `onboarding@resend.dev` funciona sem verificar nada, mas SÓ entrega para o
# e-mail dono da conta — serve para testar, não para escrever ao cliente.
#
# EMAIL_DO_DONO é quem recebe o aviso de "cliente informou pagamento".
# ═══════════════════════════════════════════
RESEND_API_KEY=
EMAIL_REMETENTE=DataTrust Audit <onboarding@resend.dev>
EMAIL_DO_DONO=

# ═══════════════════════════════════════════
# Preços (BRL) — FONTE ÚNICA
# É daqui que sai o valor cobrado no checkout E o valor exibido na tela
# (o frontend lê via GET /api/payments/plans). Havia três tabelas divergentes:
# o cliente via R$ 49,90 e era cobrado R$ 97.
# Os sufixos _BRL e _ANNUAL_BRL são os nomes que o código lê.
# Anual em branco = 12 meses com 20% de desconto.
# ═══════════════════════════════════════════
PRICE_PRO_BRL=97
PRICE_PREMIUM_BRL=247
PRICE_PRO_ANNUAL_BRL=
PRICE_PREMIUM_ANNUAL_BRL=

# Duração da assinatura após pagamento aprovado
SUBSCRIPTION_PERIOD_DAYS=30
ANNUAL_PERIOD_DAYS=365

# ═══════════════════════════════════════════
# Limites por plano (auditorias por semana)
# ═══════════════════════════════════════════
FREE_MAX_SCANS=10
PRO_MAX_SCANS=50
PREMIUM_MAX_SCANS=200

# ═══════════════════════════════════════════
# Rate limiting
# Com mais de um worker, aponte para o Redis — "memory://" conta por processo
# e o teto real vira N x o configurado.
# ═══════════════════════════════════════════
RATE_LIMIT_STORAGE_URI=memory://
RATE_LIMIT_SCAN=10/hour
RATE_LIMIT_DEEP_SCAN=3/hour
RATE_LIMIT_CHAT=20/hour
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_REGISTER=5/hour

# ═══════════════════════════════════════════
# Scanner
# 1 desliga o sandbox do Chromium. O scanner renderiza sites arbitrários, então
# só use quando o contêiner já isolar o processo.
# ═══════════════════════════════════════════
CHROMIUM_NO_SANDBOX=0

# ═══════════════════════════════════════════
# Admin Test User
# Used by: python scripts/create_admin_user.py
# ═══════════════════════════════════════════
ADMIN_TEST_EMAIL=
ADMIN_TEST_PASSWORD=
ADMIN_TEST_NAME=DataTrust Admin

# ═══════════════════════════════════════════
# Frontend Kiwify Checkout URLs
# ═══════════════════════════════════════════
VITE_KIWIFY_PRO_MONTHLY_URL=https://pay.kiwify.com.br/d1eUlrr
VITE_KIWIFY_PREMIUM_MONTHLY_URL=https://pay.kiwify.com.br/DfeG9rm
VITE_KIWIFY_PRO_YEARLY_URL=https://pay.kiwify.com.br/fJMsLEv
VITE_KIWIFY_PREMIUM_YEARLY_URL=https://pay.kiwify.com.br/HfxKSXY

# ═══════════════════════════════════════════
# Application URL
# ═══════════════════════════════════════════
VITE_APP_URL=http://localhost:8080

# ═══════════════════════════════════════════
# Supabase (Auth & Profiles)
# ═══════════════════════════════════════════
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_ADMIN_EMAIL=datatrustaudit@gmail.com
VITE_PIX_KEY=datatrustaudit@gmail.com

# Suspende o limite semanal de varreduras. Só tem efeito com
# ENVIRONMENT=development — as duas condições são exigidas, para que subir
# com esta variável ligada por engano não dê varredura ilimitada a todo mundo.
DEV_UNLIMITED_SCANS=0

# ═══════════════════════════════════════════
# Contas administradoras
# Acesso irrestrito ao produto (plano premium, cota ilimitada) e ao painel
# em /api/admin. Separadas por vírgula.
#
# Vazio = ninguém é promovido. Falha FECHADA de propósito: um padrão embutido
# no código promoveria contas em qualquer deploy que esquecesse a variável, e
# este repositório é público. Errar bloqueando é recuperável; o contrário não.
#
# A promoção alcança contas já existentes — não é preciso recadastrar.
# ═══════════════════════════════════════════
ADMIN_EMAILS=
