# DataTrust Audit — variáveis de ambiente
# Copie para .env e preencha. NUNCA versione o .env.

# ─── Obrigatórias ────────────────────────────────────────────────────────────

# Chave de assinatura dos tokens JWT. Sem ela a aplicação não sobe (de
# propósito: antes havia um default público no código e qualquer um que o
# conhecesse assinava um token válido para qualquer usuário).
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# ─── Banco de dados ──────────────────────────────────────────────────────────
# SQLite serve para desenvolvimento. Em produção use Postgres: o scanner roda
# em paralelo e o SQLite trava com escrita concorrente ("database is locked").
# Postgres: postgresql+psycopg://usuario:senha@host:5432/banco
DATABASE_URL=sqlite:///./db/gtmaudit.db

# ─── Autenticação ────────────────────────────────────────────────────────────
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── Frontend e CORS ─────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:8000
# Origens autorizadas, separadas por vírgula. Vazio = usa FRONTEND_URL.
# Não use "*": com credenciais habilitadas, qualquer site poderia fazer
# requisição autenticada em nome do usuário logado.
CORS_ALLOW_ORIGINS=

# ─── IA (chat) ───────────────────────────────────────────────────────────────
# Obtenha em: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-lite

# ─── Limites por plano (auditorias por mês) ──────────────────────────────────
FREE_MAX_SCANS=1
PRO_MAX_SCANS=50
PREMIUM_MAX_SCANS=300

# ─── Preços (BRL) ────────────────────────────────────────────────────────────
# Os nomes terminam em _BRL — é o que o código lê. Divergência aqui já causou
# cobrança de 297 num plano configurado a 247.
PRICE_PRO_BRL=97
PRICE_PREMIUM_BRL=247

# ─── Pagamentos (Mercado Pago) ───────────────────────────────────────────────
MP_ACCESS_TOKEN=
# Segredo do webhook. Sem ele a rota aceita POST de qualquer origem.
MP_WEBHOOK_SECRET=
# Duração da assinatura após o pagamento aprovado
SUBSCRIPTION_PERIOD_DAYS=30

# ─── Rate limiting ───────────────────────────────────────────────────────────
# Com mais de um worker, aponte para o Redis — "memory://" conta por processo
# e o teto real vira N x o configurado.
RATE_LIMIT_STORAGE_URI=memory://
RATE_LIMIT_SCAN=10/hour
RATE_LIMIT_DEEP_SCAN=3/hour
RATE_LIMIT_CHAT=20/hour
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_REGISTER=5/hour

# ─── Scanner ─────────────────────────────────────────────────────────────────
# 1 desliga o sandbox do Chromium. O scanner renderiza sites arbitrários, então
# só use quando o contêiner já isolar o processo.
CHROMIUM_NO_SANDBOX=0

# ─── Fila (Celery) ───────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ─── E-mail (Resend) ─────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_NOTIFICATION_EMAIL=

# ─── Ambiente ────────────────────────────────────────────────────────────────
ENVIRONMENT=development
