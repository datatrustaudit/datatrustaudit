# GTM Audit - Configurações de API

GOOGLE_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-2.5-flash
ENVIRONMENT=development

# Database and Cache
DATABASE_URL=postgresql://postgres:password@localhost:5432/gtmaudit
REDIS_URL=redis://localhost:6379/0

# Security Setup
SECRET_KEY=supersecretkey-for-jwt-token-replace-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Scanner Limits
FREE_MAX_SCANS=1
PRO_MAX_SCANS=50
PREMIUM_MAX_SCANS=300

# Payments (Mercado Pago)
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Pricing Settings
PRICE_FREE=0
PRICE_PRO=97
PRICE_PREMIUM=297
